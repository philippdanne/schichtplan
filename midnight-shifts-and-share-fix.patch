diff --git a/src/shared/format/schedule.ts b/src/shared/format/schedule.ts
index c847361..2f9e8e1 100644
--- a/src/shared/format/schedule.ts
+++ b/src/shared/format/schedule.ts
@@ -22,17 +22,34 @@ export function formatTime(iso: string): string {
   return formatter.format(d);
